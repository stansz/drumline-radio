{
  "name": "drumline-radio",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "test:sandbox": "node node_modules/vitest/vitest.mjs run --config vitest.sandbox.config.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "check:songs": "vitest run --config tools/check/vitest.config.mjs",
    "report:song": "vitest run --config tools/analysis/vitest.config.mjs",
    "analyze:midi": "node tools/analysis/reference.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
